/* SPDX-License-Identifier: GPL-2.0 */
/*
 * Minimal vmlinux.h shim for dns2ipset BPF program.
 *
 * This file is NOT auto-generated by bpftool (WSL2 kernel 6.1 + bpftool 5.15
 * mismatch prevents "bpftool btf dump … format c" from working).
 *
 * CO-RE resolves actual field offsets at load time against the target kernel's
 * BTF, so the layouts here only need to name the right structs/fields —
 * the compiler never uses the concrete offsets.
 *
 * Fields covered:
 *   struct sock_common  – skc_family, skc_dport
 *   struct sock         – __sk_common
 *   struct inet_sock    – inet_sport
 *   struct msghdr       – msg_iter
 *   struct iov_iter     – __iov, iov  (kernel 5.x vs 6.x naming)
 *   struct iovec        – iov_base, iov_len
 *   AF_INET / AF_INET6  constants
 */
#pragma once

typedef unsigned char      __u8;
typedef unsigned short     __u16;
typedef unsigned int       __u32;
typedef unsigned long long __u64;
typedef signed char        __s8;
typedef signed short       __s16;
typedef signed int         __s32;
typedef signed long long   __s64;

typedef __u8  u8;
typedef __u16 u16;
typedef __u32 u32;
typedef __u64 u64;

#ifndef AF_INET
#define AF_INET  2
#endif
#ifndef AF_INET6
#define AF_INET6 10
#endif

struct sock_common {
    __u16 skc_family;
    __u16 skc_dport; /* network byte order */
    /* ... other fields omitted; CO-RE resolves real offsets at load time */
};

struct sock {
    struct sock_common __sk_common;
    /* ... other fields omitted */
};

struct inet_sock {
    struct sock sk;
    __u16 inet_sport; /* network byte order */
    /* ... other fields omitted */
};

struct iovec {
    void  *iov_base;
    __u64  iov_len;
};

/*
 * iov_iter: kernel 5.x uses `iov`, kernel 6.x renamed it to `__iov`.
 * We declare both here; bpf_core_field_exists() picks the right one at
 * load time so the shim layout does not need to be exact.
 */
struct iov_iter {
    unsigned int type;
    __u64        iov_offset;
    __u64        count;
    union {
        const struct iovec *iov;   /* kernel <= 5.x */
        const struct iovec *__iov; /* kernel >= 6.x  */
    };
    /* ... other fields omitted */
};

struct msghdr {
    void            *msg_name;
    int              msg_namelen;
    struct iov_iter  msg_iter;
    /* ... other fields omitted */
};
